{
  "name": "thelonesomeera",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:androidtest": "node scripts/prepare-androidtest-tooling.mjs && npm --prefix showcase/androidtest run dev",
    "build:androidtest": "node scripts/prepare-androidtest-tooling.mjs && npm --prefix showcase/androidtest run build",
    "build:cod2": "npm --prefix showcase/cod2 run build",
    "build:rooms": "npm --prefix showcase/room run build",
    "build:pulsesync": "npm --prefix showcase/pulsesync run build",
    "dev:colorful_kart": "npm --prefix showcase/colorful_kart run dev",
    "build:colorful_kart": "npm --prefix showcase/colorful_kart run build",
    "dev:mini_fantasy": "npm --prefix showcase/mini_fantasy run dev",
    "build:mini_fantasy": "npm --prefix showcase/mini_fantasy run build",
    "sync:static": "node scripts/sync-static-apps.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "^16.2.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
